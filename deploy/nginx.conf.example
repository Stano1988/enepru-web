# Replace __DOMAIN__ and certificate paths. Do not use as-is.
# Configure inside nginx's http {} block.
limit_req_zone $binary_remote_addr zone=lahodny:10m rate=5r/s;
server {
    listen 80;
    server_name __DOMAIN__;
    return 308 https://__DOMAIN__$request_uri;
}
server {
    listen 443 ssl;
    server_name __DOMAIN__;
    ssl_certificate __FULLCHAIN_PATH__;
    ssl_certificate_key __PRIVATE_KEY_PATH__;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 17m;
    client_body_timeout 30s;
    access_log off;
    location / {
        limit_req zone=lahodny burst=30 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host __DOMAIN__;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For "";
        proxy_read_timeout 60s;
    }
}
