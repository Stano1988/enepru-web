# Set through secure hosting settings. This file is an example, not loaded automatically.
APP_ENV=production
APP_DATA_DIR=/var/lib/lahodny
# Fill with the actual HTTPS origin, without trailing slash. Do not invent a domain.
PUBLIC_ORIGIN=
# Only the actual reverse-proxy peer IP, comma-separated if necessary.
TRUSTED_PROXIES=127.0.0.1
SMTP_HOST=
SMTP_PORT=587
SMTP_MODE=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional direct HTTPS CRM transport. For a CRM only on your PC, use SMTP +
# structured email import instead; do not expose your home PC to the internet.
CRM_ENDPOINT=
CRM_SOURCE_SLUG=enepru
# Random >=32-character shared secret on the server ONLY; also signs metadata mail.
CRM_SHARED_SECRET=
